# Dev: copia in .env (mai committare .env).
# Prod: non copiare il file, inserisci le variabili a mano in Portainer
# (Stack → Environment variables), sostituendo ogni "<...>".


# dev | prod. In prod l'app non parte se manca SECRET_KEY, ADMIN_EMAIL o ADMIN_PASSWORD.
ENV=prod


# chiave per firmare i token JWT. Genera con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# cambiarla costringe tutti a rifare il login
SECRET_KEY=<generate-with-secrets.token_urlsafe-48>

# durata del token in minuti
ACCESS_TOKEN_EXPIRE_MINUTES=30


# primo admin: creato solo al primo avvio, se non ci sono utenti.
# Email reale (per il recupero) e password forte (almeno 16 caratteri).
ADMIN_EMAIL=<your-admin-email>
ADMIN_PASSWORD=<strong-random-password>


# usate da Postgres al primo avvio e dal backend per connettersi
POSTGRES_USER=<choose-a-username>
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=<choose-a-db-name>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# coerente con le variabili sopra; host "db" = nome del servizio in docker-compose
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db/<POSTGRES_DB>


# domini che possono chiamare il backend: separati da virgola, senza spazi, senza "*"
# dev: "http://localhost:5173,http://127.0.0.1:5173"
CORS_ORIGINS=https://your-prod-domain.example.org


# indirizzo pubblico del sito, usato nei link delle mail. Senza slash finale.
# dev: "http://localhost:5173". Obbligatorio in prod.
SITE_URL=https://your-prod-domain.example.org


# server per le mail (reset password, benvenuto).
# Dev: facoltative, senza SMTP_HOST non parte nessuna mail. Prod: obbligatorie.
# Gmail: SMTP_PASSWORD = App Password, SMTP_FROM uguale a SMTP_USER (es. noreply.pcm@unimore.it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-password-or-app-password>
SMTP_FROM=<from-address>
